  "create_sql": "CREATE TABLE events (\n\ttitle VARCHAR(255) NOT NULL, \n\tstart_time DATETIME NOT NULL, \n\tend_time DATETIME NOT NULL, \n\tis_blocking BOOLEAN, \n\tlocation VARCHAR(255), \n\tdescription VARCHAR(1000), \n\tis_recurring BOOLEAN, \n\trecurrence_pattern JSON, \n\trecurrence_parent_id VARCHAR(36), \n\tid VARCHAR(36) NOT NULL, \n\tcreated_at DATETIME NOT NULL, \n\tupdated_at DATETIME NOT NULL, event_type VARCHAR(11), status VARCHAR(11), allows_multitasking BOOLEAN, buffer_before_minutes INTEGER, buffer_after_minutes INTEGER, priority INTEGER, is_moveable BOOLEAN, min_notice_hours INTEGER, project_id VARCHAR(36), meal_id VARCHAR(36), attendees JSON, required_resources JSON, reminder_minutes_before JSON, notifications_enabled BOOLEAN, \n\tPRIMARY KEY (id)\n)"
